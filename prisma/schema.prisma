// Wearable-art platform data model.
// PostgreSQL is the datasource for every environment (dev/staging/prod) —
// see README.md "Database" for local setup. Connection details live in
// DATABASE_URL only (see prisma.config.ts); nothing here is provider-specific
// beyond the `provider` line itself.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// role: "customer" | "artist" | "admin"
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("customer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?
  artist          Artist?
  commissions     Commission[]
  reviews         Review[]
  cart            Cart?
  retailOrders    RetailOrder[]
}

model CustomerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  shippingAddress String?
  bio             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catalog primitives
// ---------------------------------------------------------------------------

// type: "jacket" | "jeans" | "vest" | "sneakers" | "other"
model Garment {
  id             String  @id @default(cuid())
  type           String
  label          String
  description    String
  basePriceCents Int
  imageUrl       String?
  active         Boolean @default(true)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Commission — the spine of a single customer's custom piece
// ---------------------------------------------------------------------------

// status: "intake" | "in_studio" | "concept_selected" | "revising" |
//         "approved" | "in_production" | "completed" | "cancelled"
model Commission {
  id         String  @id @default(cuid())
  customerId String
  customer   User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  garmentId  String
  garment    Garment @relation(fields: [garmentId], references: [id])

  status String @default("intake")

  // Studio intake fields
  storyText       String // customer's story/inspiration, free text
  aestheticText   String? // preferred aesthetic in their own words
  themesJson      String  @default("[]") // JSON string array
  colorsJson      String  @default("[]") // JSON string array
  placement       String? // e.g. "back panel", "left sleeve"
  occasion        String?
  budgetTierCents Int?

  referenceImages   ReferenceImage[]
  concepts          Concept[]
  artistAssignment  ArtistAssignment?
  productionStages  ProductionStage[]
  productionUpdates ProductionUpdate[]
  artwork           Artwork?
  order             Order?
  review            Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([garmentId])
}

model ReferenceImage {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  url          String
  note         String?
  uploadedAt   DateTime   @default(now())

  @@index([commissionId])
}

// ---------------------------------------------------------------------------
// Concept + versioning (append-only version history)
// ---------------------------------------------------------------------------

model Concept {
  id               String     @id @default(cuid())
  commissionId     String
  commission       Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  currentVersionId String?

  creativeDirections CreativeDirection[]
  versions           ConceptVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commissionId])
}

// One of the 3 (or more) proposed directions for a concept.
model CreativeDirection {
  id           String  @id @default(cuid())
  conceptId    String
  concept      Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  title        String // e.g. "MEMORY ARCHIVE"
  narrative    String // why this direction fits their story
  colorPalette String // JSON string array of hex/names
  themesJson   String // JSON string array
  placement    String?
  order        Int     @default(0)
  isSelected   Boolean @default(false)

  versions ConceptVersion[]

  createdAt DateTime @default(now())

  @@index([conceptId])
}

// status: "draft" | "proposed" | "revision_requested" | "revised" | "approved"
// Append-only: a revision creates a NEW row, never mutates a prior one.
// (conceptId, versionNumber) is unique so two concurrent/duplicate writes for
// the same concept can never silently produce two rows both claiming to be
// the same version number — see selectDirection()/reviseConcept() in
// src/lib/studio/service.ts, which compute the next number from the current
// max rather than hardcoding it, with this constraint as the hard backstop.
model ConceptVersion {
  id                  String            @id @default(cuid())
  conceptId           String
  concept             Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  creativeDirectionId String
  creativeDirection   CreativeDirection @relation(fields: [creativeDirectionId], references: [id])
  versionNumber       Int
  designSpecJson      String // structured spec from DesignInterpreter
  imageUrl            String? // concept visualization (always labeled "concept")
  aiRationale         String?
  customerFeedback    String?
  feasibilityNotes    String? // advisory only, from FeasibilityAssistant
  status              String            @default("proposed")

  createdAt DateTime @default(now())

  approvedAsArtwork Artwork?

  @@unique([conceptId, versionNumber])
  @@index([creativeDirectionId])
}

// ---------------------------------------------------------------------------
// Artists + production
// ---------------------------------------------------------------------------

// capacityStatus: "available" | "limited" | "full"
model Artist {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  bio            String?
  styleTagsJson  String  @default("[]")
  portfolioJson  String  @default("[]")
  capacityStatus String  @default("available")

  assignments ArtistAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// status: "assigned" | "in_progress" | "completed" | "reassigned"
model ArtistAssignment {
  id           String     @id @default(cuid())
  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  status       String     @default("assigned")
  assignedAt   DateTime   @default(now())

  @@index([artistId])
}

// stage: "artist_review" | "base_preparation" | "sketch" | "painting" |
//        "detail_work" | "quality_control" | "packed" | "shipped" | "delivered"
// Deliberately a plain String, not a DB-level enum: the canonical value set
// is enforced at the application boundary (STAGE_ORDER in
// src/lib/admin/service.ts), not the database, for both this model and
// ProductionUpdate.stage below. Adding a Postgres native enum later would be
// a real option, but it's not required for correctness and isn't part of
// this migration's scope.
model ProductionStage {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  stage        String
  enteredAt    DateTime   @default(now())
  exitedAt     DateTime?
  notes        String?

  @@index([commissionId])
}

model ProductionUpdate {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  stage        String
  photoUrl     String?
  message      String
  createdAt    DateTime   @default(now())

  @@index([commissionId])
}

// ---------------------------------------------------------------------------
// Finished piece + Art Passport
// ---------------------------------------------------------------------------

model Artwork {
  id                String         @id @default(cuid())
  commissionId      String         @unique
  commission        Commission     @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  approvedVersionId String         @unique
  approvedVersion   ConceptVersion @relation(fields: [approvedVersionId], references: [id])
  materials         String?
  finalDescription  String?
  completedAt       DateTime?

  passport ArtPassport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtPassport {
  id                    String    @id @default(cuid())
  artworkId             String    @unique
  artwork               Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  pieceId               String    @unique // public-facing piece identifier, e.g. "CD-2026-0001"
  publicSlug            String    @unique
  qrCodeDataUrl         String?
  careInstructions      String?
  authenticityStatement String?
  publishedAt           DateTime?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

// status: "pending" | "paid" | "fulfilled" | "cancelled"
// "paid" is the authoritative production gate (see advanceStage() in
// src/lib/admin/service.ts) — set only by the Stripe webhook handler or the
// admin manual-reconciliation path (src/lib/payments/), both of which write
// it in the same transaction as Payment.status, so the two never drift.
model Order {
  id           String     @id @default(cuid())
  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  priceCents   Int
  currency     String     @default("usd")
  status       String     @default("pending")

  payment  Payment?
  shipment Shipment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// status: "pending" | "checkout_created" | "succeeded" | "failed" | "refunded"
// C3: backed by Stripe Checkout Sessions (src/lib/payments/). "checkout_created"
// means a session exists but has not yet been confirmed by webhook — never
// treat it as paid. providerSessionId/providerPaymentIntentId are
// Stripe-specific reconciliation identifiers; nothing outside
// src/lib/payments/ should need to know they're Stripe-shaped.
model Payment {
  id                      String    @id @default(cuid())
  orderId                 String    @unique
  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                String    @default("manual")
  amountCents             Int
  status                  String    @default("pending")
  providerSessionId       String?   @unique
  providerPaymentIntentId String?
  paidAt                  DateTime?

  createdAt DateTime @default(now())
}

// Persistent webhook-delivery idempotency: the same provider event may be
// delivered more than once (network retries, provider-side redelivery). A
// unique constraint on (provider, eventId) — not an in-memory flag — is what
// actually guarantees a duplicate delivery can never re-apply a payment
// state transition. See src/app/api/webhooks/stripe/route.ts.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
}

model Review {
  id           String     @id @default(cuid())
  commissionId String     @unique
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User       @relation(fields: [customerId], references: [id])
  rating       Int
  text         String?
  createdAt    DateTime   @default(now())

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Retail — surplus branded stock + thrifted imported jackets, sold off the
// shelf (not bespoke). Deliberately a parallel commerce domain rather than
// folded into Commission -> Order -> Payment above: Order.commissionId is a
// required, unique FK tightly coupled to the bespoke pipeline, and Prisma has
// no clean polymorphic relations. RetailOrder/RetailPayment mirror
// Order/Payment's shape instead, so the existing PaymentService interface and
// the shared WebhookEvent idempotency table are reused as-is — only the
// Stripe webhook handler's lookup gets a parallel branch (see
// src/app/api/webhooks/stripe/route.ts).
// ---------------------------------------------------------------------------

// condition: "new" | "like_new" | "good" | "fair"
// source: "surplus_branded" | "thrifted_imported"
model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  category    String // e.g. "shirts" | "t_shirts" | "denim" | "cargos" | "shoes" | "activewear" | "jackets"
  brand       String?
  description String
  size        String?
  condition   String  @default("good")
  source      String
  priceCents  Int
  currency    String  @default("inr")
  quantity    Int     @default(1)
  active      Boolean @default(true)

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems RetailOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([source])
  @@index([active])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)

  @@index([productId])
}

// One cart per signed-in customer. Guest (pre-login) carts aren't supported
// yet — a v1 scope cut, not an oversight; adding one later is an additive
// nullable sessionId column plus a merge-on-login step, not a redesign.
model Cart {
  id         String @id @default(cuid())
  customerId String @unique
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([productId])
}

// status: "pending" | "paid" | "fulfilled" | "cancelled"
// Mirrors Order above, for the retail domain.
model RetailOrder {
  id              String @id @default(cuid())
  customerId      String
  customer        User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          String @default("pending")
  subtotalCents   Int
  currency        String @default("inr")
  shippingAddress String

  items   RetailOrderItem[]
  payment RetailPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// Line items snapshot the product's title/price at purchase time so a later
// edit to Product (price change, deletion) never retroactively rewrites a
// past order's record — same append-only reasoning as ConceptVersion.
model RetailOrderItem {
  id                 String      @id @default(cuid())
  retailOrderId      String
  retailOrder        RetailOrder @relation(fields: [retailOrderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product     @relation(fields: [productId], references: [id])
  titleSnapshot      String
  priceCentsSnapshot Int
  quantity           Int         @default(1)

  @@index([retailOrderId])
  @@index([productId])
}

// status: "pending" | "checkout_created" | "succeeded" | "failed" | "refunded"
// Mirrors Payment above exactly, including its reuse of the shared
// (provider, eventId) WebhookEvent idempotency table — only the FK target
// differs (RetailOrder instead of Order).
model RetailPayment {
  id                      String      @id @default(cuid())
  retailOrderId           String      @unique
  retailOrder             RetailOrder @relation(fields: [retailOrderId], references: [id], onDelete: Cascade)
  provider                String      @default("manual")
  amountCents             Int
  status                  String      @default("pending")
  providerSessionId       String?     @unique
  providerPaymentIntentId String?
  paidAt                  DateTime?

  createdAt DateTime @default(now())
}
