# --- Database -----------------------------------------------------------
# PostgreSQL connection string, via the @prisma/adapter-pg driver adapter.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# See README.md "Database" for local setup (native Postgres or Docker Compose)
# and for staging/production environment separation.
DATABASE_URL="postgresql://customdenim:replace-with-a-real-password@localhost:5432/customdenim_dev?schema=public"

# Optional. Only used by `prisma migrate dev`/`migrate diff` (a scratch
# database Prisma replays migration history into to detect drift). Point it
# at a database that's safe to drop/recreate — never dev or prod data.
# SHADOW_DATABASE_URL="postgresql://customdenim:replace-with-a-real-password@localhost:5432/customdenim_shadow?schema=public"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs. Generate your own with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- AI ---------------------------------------------------------------------
# Required for the Custom Creation Studio's Creative Director to call Claude.
# Without it, the Studio falls back to a clearly-labeled offline demo mode.
ANTHROPIC_API_KEY=""

# Optional: override the Claude model used for AI calls (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- App --------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# --- Environment ------------------------------------------------------------
# Discriminates real environments. Must be "development", "staging", or
# "production". prisma/seed.ts refuses to run unless this is "development"
# or "staging" — an unset or unrecognized value is treated the same as
# production and refused.
APP_ENV="development"
