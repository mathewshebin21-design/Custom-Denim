# --- Database -----------------------------------------------------------
# PostgreSQL connection string, via the @prisma/adapter-pg driver adapter.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# See README.md "Database" for local setup (native Postgres or Docker Compose)
# and for staging/production environment separation.
DATABASE_URL="postgresql://customdenim:replace-with-a-real-password@localhost:5432/customdenim_dev?schema=public"

# Optional. Only used by `prisma migrate dev`/`migrate diff` (a scratch
# database Prisma replays migration history into to detect drift). Point it
# at a database that's safe to drop/recreate — never dev or prod data.
# SHADOW_DATABASE_URL="postgresql://customdenim:replace-with-a-real-password@localhost:5432/customdenim_shadow?schema=public"

# --- Storage ----------------------------------------------------------------
# "local" (recommended for dev) writes to .local-storage/ (gitignored) and
# serves it through /api/storage/local/... — no bucket/credentials needed.
# See README.md "Object storage" for local vs. S3-compatible setup.
STORAGE_PROVIDER="local"

# Required only when STORAGE_PROVIDER="s3". Works against real AWS S3
# (leave S3_ENDPOINT unset) or any S3-compatible provider — Cloudflare R2,
# MinIO, DigitalOcean Spaces, Backblaze B2 — by setting S3_ENDPOINT (and
# S3_FORCE_PATH_STYLE where that provider's docs say to) to that provider's
# endpoint. Two separate buckets, not per-object ACLs: one bucket configured
# public-read (fronting it with a CDN is a good idea but not required by
# this app), one strictly private (accessed only via signed URLs).
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"
# S3_ACCESS_KEY_ID="replace-with-a-real-access-key-id"
# S3_SECRET_ACCESS_KEY="replace-with-a-real-secret-access-key"
# S3_PUBLIC_BUCKET="customdenim-public"
# S3_PRIVATE_BUCKET="customdenim-private"
# S3_PUBLIC_BASE_URL="https://replace-with-your-public-bucket-domain"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs (and, in local storage mode, to sign
# local private-asset URLs). Generate your own with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- AI ---------------------------------------------------------------------
# Required for the Custom Creation Studio's Creative Director to call Claude.
# Without it, the Studio falls back to a clearly-labeled offline demo mode.
ANTHROPIC_API_KEY=""

# Optional: override the Claude model used for AI calls (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- App --------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# --- Environment ------------------------------------------------------------
# Discriminates real environments. Must be "development", "staging", or
# "production". prisma/seed.ts refuses to run unless this is "development"
# or "staging" — an unset or unrecognized value is treated the same as
# production and refused.
APP_ENV="development"
